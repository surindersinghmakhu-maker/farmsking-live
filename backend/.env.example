# Server Configuration
PORT=4100
NODE_ENV=development
API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins (leave empty to allow all - dev only)
CORS_ORIGINS=

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/farmsking?schema=public"

# JWT Secrets - generate a long random value for production, never commit the real value
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRATION=7d

# Weather (farmer weather card + weather tips) uses Open-Meteo, which is free and needs no API key.

# UPI payment links (order checkout + plan payment) - your receiving VPA and display name
UPI_PAYEE_VPA=yourbusiness@upi
UPI_PAYEE_NAME=FarmsKing
