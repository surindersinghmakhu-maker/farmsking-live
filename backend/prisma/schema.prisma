  user             User?     @relation("LabourWorkerUser", fields: [userId], references: [id], onDelete: SetNull)
  name             String
  mobile           String?
  address          String?
  defaultDailyWage Decimal?  @db.Decimal(12, 2)
  defaultRate      Decimal?  @db.Decimal(12, 2)
  defaultUnit      String?   @default("DAILY")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  labourEntries   LabourEntry[]
  workEntries     LabourWorkEntry[]
  payments        LabourPayment[]
  spraysPerformed Spray[]

  @@index([farmerId])
  @@index([farmId])
  @@index([mobile])
  @@map("labour_workers")
}

model LabourEntry {
  id           String         @id @default(uuid())
  farmId       String
  farm         Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plotId       String?
  plot         Plot?          @relation(fields: [plotId], references: [id], onDelete: SetNull)
