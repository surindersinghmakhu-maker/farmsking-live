  lowStockThreshold Float?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  transactions InventoryTransaction[]

  @@index([farmId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id                 String                   @id @default(uuid())
  inventoryItemId    String
  inventoryItem      InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  transactionType    InventoryTransactionType
  quantity           Float
  transactionDate    DateTime
  relatedCropCycleId String?
  relatedCropCycle   CropCycle?               @relation(fields: [relatedCropCycleId], references: [id], onDelete: SetNull)
  relatedExpenseId   String?
  relatedExpense     Expense?                 @relation(fields: [relatedExpenseId], references: [id], onDelete: SetNull)
  notes              String?
  recordedById       String
  recordedBy         User                     @relation(fields: [recordedById], references: [id])
  createdAt          DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([relatedCropCycleId])
  @@index([relatedExpenseId])
  @@map("inventory_transactions")
}

model Machinery {
  id        String             @id @default(uuid())
  farmId    String
  farm      Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name      String
  ownership MachineryOwnership
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  expenses Expense[]

  @@index([farmId])
  @@map("machinery")
}

model IrrigationRecord {
  id              String     @id @default(uuid())
  plotId          String
  plot            Plot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropCycleId     String?
  cropCycle       CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  irrigationDate  DateTime
  method          String?
  durationMinutes Int?
  waterSource     String?
  expenseId       String?
  expense         Expense?   @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  notes           String?
