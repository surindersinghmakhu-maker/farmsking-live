  pricePerUnit Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([harvestId])
  @@map("harvest_grade_breakdowns")
}

model InventoryItem {
  id                String            @id @default(uuid())
