  dose          String?
  alternative1  String?
  alternative2  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([advisorId])
  @@map("spray_item_templates")
}

model CropProblem {
  id                 String               @id @default(uuid())
  cropCycleId        String
  cropCycle          CropCycle            @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
