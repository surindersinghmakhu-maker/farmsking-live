datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum Role {
  FARMER
  ADVISOR
  GARDENER
  CUSTOMER
  BUSINESS_PARTNER
  ADMIN
  SUPER_ADMIN
  OPERATOR
  LABOUR
}

/// Fixed, read-only capabilities an Admin/Super Admin can grant to a specific Operator account.
/// An Operator sees nothing beyond whichever of these they've been granted — no per-capability
/// customization beyond this list.
enum OperatorPermission {
  VIEW_ORDERS
  VIEW_COUPONS
  VIEW_USERS
  VIEW_WALLETS
  VIEW_FARMER_PLANS
}

enum AreaUnit {
  ACRE
  HECTARE
  BIGHA
  GUNTA
}

enum CropStatus {
  PLANNED
  ACTIVE
  HARVESTING
  COMPLETED
  FAILED
  DEACTIVE
}

enum CropCategory {
  FLOWERS
  VEGETABLES
  FRUITS
  GRAINS
  PULSES
  SPICES
  CASH_CROP
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  CREDIT
  OTHER
}

enum LabourWageType {
  DAILY
  CONTRACT
  PIECE_RATE
}

enum FertilizerType {
  ORGANIC
  CHEMICAL
  BIO
}

enum SprayType {
  PESTICIDE
  FUNGICIDE
  HERBICIDE
  INSECTICIDE
  GROWTH_REGULATOR
  OTHER
}

enum SprayScheduleStatus {
  PENDING
  COMPLETED
  SKIPPED
  OVERDUE
}

enum CropProblemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CropProblemStatus {
  REPORTED
  UNDER_REVIEW
  ADVISOR_RESPONDED
  RESOLVED
  CLOSED
}

enum InventoryItemType {
  SEED
  FERTILIZER
  PESTICIDE
  PRODUCE
  EQUIPMENT_PART
  OTHER
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTAGE
}

enum MachineryOwnership {
  OWNED
  RENTED
}

enum AdvisorAssignmentStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum NotificationType {
  SPRAY_REMINDER
  PAYMENT_DUE
  ADVISOR_MESSAGE
  CROP_PROBLEM_UPDATE
  MARKET_RATE_ALERT
  SYSTEM
}

enum SubscriptionPlanStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
  EXPIRED
}

enum PlanPaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
}

enum ActivityType {
  IRRIGATION
  FERTILIZER
  SPRAY
  MONITORING
  HARVEST
  OTHER
}

enum ActivityStatus {
  PENDING
  COMPLETED
  SKIPPED
  OVERDUE
}

enum AdvisorType {
  FARM
  GARDEN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum CouponKind {
  GENERIC
  PERSONAL_INVITE
  PARTNER_REFERRAL
  REFERRAL_WELCOME
}

enum PlanCouponCategory {
  FARMER_PLAN
  ADVISOR_PLAN
}

enum PartyType {
  INDIVIDUAL
  FIRM
}

enum PartyRole {
  FARMER
  CUSTOMER
  SUPPLIER
  VENDOR
  LABOUR
  ARHTIYA
  BUSINESS_PARTNER
  ADVISOR
}

enum ArhtiyaTransactionType {
  ADVANCE_TAKEN
  ADVANCE_REPAID
  CROP_SALE_CREDIT
  COMMISSION_FEE
  MANDI_CHARGES
  SETTLEMENT_PAYOUT
}

enum MandiUnit {
  QUINTAL
  BAG_50KG
  BAG_35KG
  MANN
  KG
}

enum FarmerPlanType {
  RECORD_ONLY
  WITH_ADVISOR
}

enum FarmerSubscriptionPlan {
  FREE
  PRO
  SMART
  SUPER
}

enum AdvisorSubscriptionPlan {
  LITE
  PLUS
}

enum GardenerSubscriptionPlan {
  FREE
  PREMIUM
}

enum PartnerAssignmentStatus {
  ACTIVE
  REVOKED
}

enum CropAdvisorReviewStatus {
  NONE
  PENDING
  ACCEPTED
}

enum CropHarvestType {
  ONE_TIME
  CONTINUOUS
}

enum CropCycleStage {
  PLANTATION
  VEGETATIVE
  FLOWERING
  HARVESTING
  COMPLETED
}

enum WeatherTipTrigger {
  HIGH_TEMPERATURE
  RAIN
  COLD
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderPaymentMode {
  COD
  ONLINE
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum SoilType {
  ALLUVIAL
  BLACK
  RED
  LATERITE
  SANDY
  CLAY
  LOAMY
  SALINE_ALKALINE
}

enum WaterType {
  BOREWELL_TUBEWELL
  CANAL
  RIVER
  POND_LAKE
  RAINFED
  TAP_MUNICIPAL
}

// ─── Phase 1: Users, Farms, Plots, Crops ────────────────────────────────

model User {
  id                   String               @id @default(uuid())
  kingId               String?              @unique
  mobile               String               @unique
  passwordHash         String
  role                 Role                 @default(FARMER)
  /// Every role this account has ever been granted (e.g. a Customer who became a Farmer and was also
  /// made a Business Partner holds both) — `role` above stays the "current/primary" dashboard.
  roles                Role[]               @default([])
  /// Roles an Admin has deactivated — stays in `roles` for history (never deleted), just excluded
  /// from what RolesGuard treats as active until an Admin reactivates it.
  deactivatedRoles     Role[]               @default([])
  name                 String
  email                String?
  village              String?
  district             String?
  state                String?
  pincode              String?
  postOffice           String?
  securityQuestion     String?
  securityAnswerHash   String?
  preferredLanguage    String               @default("en")
  notificationsEnabled Boolean              @default(true)
  whatsappGroupEnabled Boolean              @default(true)
  whatsappGroupJid     String?
  /// Self-service weather-alert thresholds (any role). Null threshold = that side of the check is off;
  /// a set value both enables and defines it. Advisors additionally use these to flag farmers whose
  /// current temperature/rain falls outside the configured range.
  weatherAlertMinTempC   Float?
  weatherAlertMaxTempC   Float?
  weatherAlertRainEnabled Boolean            @default(false)
  photoUrl             String?
  sprayTankSizeL       Int?
  soilType             SoilType?
  waterType            WaterType?
  specialization       String?
  bio                  String?
  yearsExperience      Int?
  advisorType          AdvisorType?
  /// Advisor-only display profile — required (alongside the payout fields below) before an Advisor's wallet can be withdrawn from.
  qualification             String?
  profileTitle              String?
  /// Business Partner / Advisor payout profile — all required before their wallet can be withdrawn from (see WithdrawalsService.create).
  upiId                     String?
  billPrintingAddress       String?
  panNumber                 String?
  alternativeMobile         String?
  bankAccountNumber         String?
  bankIfsc                  String?
  bankAccountHolderName     String?
  operatorPermissions  OperatorPermission[] @default([])
  /// Who referred this account in — set once at signup (referral code) or by a Super Admin afterwards, never changed again.
  referredById              String?
  referredBy                User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                 User[]               @relation("UserReferrals")
  /// Denormalized for quick display to the referred customer — the code of their auto-issued REFERRAL_WELCOME coupon.
  /// WhatsApp / Phone verification status & temporary OTP storage
  isPhoneVerified      Boolean              @default(false)
  otpCodeHash          String?
  otpExpiresAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  farms Farm[]

  customers                     Customer[]
  expensesRecorded              Expense[]
  salesRecorded                 Sale[]
  paymentsRecorded              Payment[]
  labourEntriesRecorded         LabourEntry[]
  labourWorkersCreated          LabourWorker[]       @relation("FarmerLabourWorkers")
  labourWorkerUser              LabourWorker?        @relation("LabourWorkerUser")
  labourWorkEntriesRecorded     LabourWorkEntry[]    @relation("WorkEntriesRecordedBy")
  labourWorkEntriesAsFarmer     LabourWorkEntry[]    @relation("FarmerWorkEntries")
  labourPaymentsRecorded        LabourPayment[]      @relation("LabourPaymentsRecordedBy")
  labourPaymentsAsFarmer        LabourPayment[]      @relation("FarmerLabourPayments")
  fertilizersAdded              Fertilizer[]
  fertilizerUsagesRecorded      FertilizerUsage[]
  spraysRecorded                Spray[]
  spraySchedulesCreated         SpraySchedule[]
  sprayItemTemplates            SprayItemTemplate[]
  cropProblemsReported          CropProblem[]          @relation("CropProblemReporter")
  cropProblemsAssigned          CropProblem[]          @relation("CropProblemAdvisor")
  harvestsRecorded              Harvest[]
  inventoryTransactionsRecorded InventoryTransaction[]
  irrigationRecordsRecorded     IrrigationRecord[]
  advisorAssignmentsAsAdvisor   AdvisorAssignment[]    @relation("AdvisorAssignmentAdvisor")
  advisorAssignmentsAsFarmer    AdvisorAssignment[]    @relation("AdvisorAssignmentFarmer")
  advisorAssignmentsCreated     AdvisorAssignment[]    @relation("AdvisorAssignmentAssignedBy")
  callRequestsAsFarmer          CallRequest[]          @relation("CallRequestsFarmer")
  callRequestsAsAdvisor         CallRequest[]          @relation("CallRequestsAdvisor")
  partnerAssignmentsAsPartner   PartnerAssignment[]    @relation("PartnerAssignmentPartner")
  partnerAssignmentAsCustomer   PartnerAssignment?     @relation("PartnerAssignmentCustomer")
  notifications                 Notification[]
  gardens                       Garden[]
  customerOrders                CustomerOrder[]
  partnerReferrals              PartnerReferral[]
  referralsSent                 UserReferral[]         @relation("ReferrerUser")
  referralReceived              UserReferral?          @relation("ReferredUser")
  royaltiesReceived             ReferralRoyalty[]      @relation("RoyaltyBeneficiary")
  royaltiesGenerated            ReferralRoyalty[]      @relation("RoyaltySourceUser")
  voiceAILogs                   VoiceAILog[]
  farmerPriceLockContracts      PriceLockContract[]    @relation("FarmerPriceLock")
  buyerPriceLockContracts       PriceLockContract[]    @relation("BuyerPriceLock")
  advisorSubscriptionsAsFarmer  AdvisorSubscription[]  @relation("SubscriptionFarmer")


  advisorSubscriptionsApproved  AdvisorSubscription[]  @relation("SubscriptionApprovedBy")
  planPaymentRequestsAsFarmer   PlanPaymentRequest[]   @relation("PlanPaymentFarmer")
  planPaymentRequestsConfirmed  PlanPaymentRequest[]   @relation("PlanPaymentConfirmedBy")
  farmerPlanPaymentRequestsAsFarmer  FarmerPlanPaymentRequest[] @relation("FarmerPlanPaymentFarmer")
  farmerPlanPaymentRequestsConfirmed FarmerPlanPaymentRequest[] @relation("FarmerPlanPaymentConfirmedBy")
  activitySchedulesCreated      CropActivitySchedule[] @relation("ActivityCreatedByAdvisor")
  activitySchedulesCompleted    CropActivitySchedule[] @relation("ActivityCompletedBy")
  uploads                       Upload[]

  couponsAsBusinessPartner            Coupon[]             @relation("BusinessPartnerCoupons")
  couponsCreatedByAdmin               Coupon[]             @relation("CouponsCreatedByAdmin")
  couponRedemptionsAsCustomer         CouponRedemption[]   @relation("CouponRedemptionsCustomer")
  walletTransactions                  WalletTransaction[]  @relation("WalletTransactions")
  walletTransactionsRelated           WalletTransaction[]  @relation("WalletTransactionsRelatedUser")
  auditLogs                           AuditLog[]           @relation("AuditLogsActor")
  parties                             Party[]
  unifiedPartiesCreated               UnifiedParty[]       @relation("FarmerPrivateParties")
  unifiedPartyAccount                 UnifiedParty?        @relation("UserUnifiedParty")
  arhtiyaTransactions                 ArhtiyaTransaction[]
  saleBills                           SaleBill[]
  paymentReceipts                     PaymentReceipt[]
  withdrawalRequestsAsPartner         WithdrawalRequest[]  @relation("WithdrawalRequestsPartner")
  withdrawalRequestsProcessed         WithdrawalRequest[]  @relation("WithdrawalRequestsProcessedBy")
  planRenewalCouponsCreated           PlanRenewalCoupon[]  @relation("PlanRenewalCouponsCreatedBy")
  planRenewalCouponsAssigned          PlanRenewalCoupon[]  @relation("PlanRenewalCouponsAssignedFarmer")
  planRenewalCouponsAssignedAsAdvisor PlanRenewalCoupon[]  @relation("PlanRenewalCouponsAssignedAdvisor")
  basicPlanCouponsCreated             BasicPlanCoupon[]    @relation("BasicPlanCouponsCreatedBy")
  basicPlanCouponsPurchased           BasicPlanCoupon[]    @relation("BasicPlanCouponsPurchasedBy")
  basicPlanCouponsUsed                BasicPlanCoupon[]    @relation("BasicPlanCouponsUsedByFarmer")
  appSettingsUpdated                  AppSetting[]         @relation("AppSettingUpdatedBy")
  couponSystemSettingsUpdated         CouponSystemSetting[] @relation("CouponSystemSettingUpdatedBy")
  adminChatsAsFarmer                  AdminChatMessage[]    @relation("AdminChatFarmer")
  adminChatsAsAdmin                   AdminChatMessage[]    @relation("AdminChatAdmin")
  customerAddresses                   CustomerAddress[]
  messagesSent                        Message[]            @relation("MessagesSent")
  messagesReceived                    Message[]            @relation("MessagesReceived")
  weatherTipTemplatesCreated          WeatherTipTemplate[] @relation("WeatherTipTemplatesCreatedBy")
  productsCreated                     Product[]            @relation("ProductsCreatedBy")
  ordersPacked                        CustomerOrder[]      @relation("OrdersPackedBy")
  ordersDispatched                    CustomerOrder[]      @relation("OrdersDispatchedBy")

  // Farmer Plan (3-tier)
  farmerPlan                                 FarmerPlan?
  farmerPlanCouponsCreated                   FarmerPlanCoupon[]   @relation("FarmerPlanCouponsCreatedBy")
  farmerPlanCouponsAssigned                  FarmerPlanCoupon[]   @relation("FarmerPlanCouponsAssignedFarmer")
  farmerPlanCouponsAssignedAsAdvisor         FarmerPlanCoupon[]   @relation("FarmerPlanCouponsAssignedAdvisor")
  farmerPlanCouponsAssignedAsBusinessPartner FarmerPlanCoupon[]   @relation("FarmerPlanCouponsAssignedBusinessPartner")
  farmerPlanPricingUpdated                   FarmerPlanPricing[]  @relation("FarmerPlanPricingUpdatedBy")
  farmerPlanCouponsUsed                      FarmerPlanCoupon[]   @relation("FarmerPlanCouponsUsedBy")
  gardenerPlan                               GardenerPlan?
  gardenerPlanCouponsCreated                 GardenerPlanCoupon[] @relation("GardenerPlanCouponsCreatedBy")
  gardenerPlanCouponsAssigned                GardenerPlanCoupon[] @relation("GardenerPlanCouponsAssignedGardener")
  gardenerPlanCouponsUsed                    GardenerPlanCoupon[] @relation("GardenerPlanCouponsUsedBy")
  advisorTierPlan                            AdvisorTierPlan?

  // King Connect Relations
  kingConnectInitiated   KingConnectLink[]        @relation("KingConnectInitiator")
  kingConnectReceived    KingConnectLink[]        @relation("KingConnectReceiver")
  syncRequestsSent       P2pLedgerSyncRequest[]   @relation("SyncSender")
  syncRequestsReceived   P2pLedgerSyncRequest[]   @relation("SyncReceiver")
  demandsRequested       DemandRequest[]          @relation("DemandRequester")
  demandsAsFarmer        DemandRequest[]          @relation("DemandFarmer")
  kingPaymentsSent       KingPaymentRequest[]     @relation("KingPaymentSender")
  kingPaymentsReceived   KingPaymentRequest[]     @relation("KingPaymentReceiver")
  // Group Voice Call Relations
  groupVoiceCallsHosted      GroupVoiceCall[]            @relation("VoiceCallHost")
  groupVoiceCallParticipations GroupVoiceCallParticipant[] @relation("VoiceCallParticipant")

  @@map("users")
}

model Farm {
  id               String    @id @default(uuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  village          String?
  district         String?
  state            String?
  totalArea        Float
  areaUnit         AreaUnit  @default(ACRE)
  soilType         String?
  irrigationSource String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  plots Plot[]

  expenses       Expense[]
  sales          Sale[]
  labourWorkers  LabourWorker[]
  labourEntries  LabourEntry[]
  labourWorkEntries LabourWorkEntry[]
  inventoryItems InventoryItem[]
  machinery      Machinery[]

  @@index([ownerId])
  @@map("farms")
}

model Plot {
  id             String    @id @default(uuid())
  farmId         String
  farm           Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name           String
  area           Float
  areaUnit       AreaUnit  @default(ACRE)
  soilType       String?
  irrigationType String?
  waterSource    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  cropCycles CropCycle[]

  expenses          Expense[]
  sales             Sale[]
  labourEntries     LabourEntry[]
  labourWorkEntries LabourWorkEntry[]
  irrigationRecords IrrigationRecord[]
  satelliteScans    PlotSatelliteScan[]

  @@index([farmId])
  @@map("plots")
}


model CropCycle {
  id                   String                  @id @default(uuid())
  cropId               String?                 @unique
  plotId               String
  plot                 Plot                    @relation(fields: [plotId], references: [id], onDelete: Cascade)
  category             CropCategory?
  cropName             String
  variety              String?
  area                 Float?
  plantCount           Int?
  sowingDate           DateTime?
  transplantDate       DateTime?
  expectedHarvestDate  DateTime?
  actualHarvestDate    DateTime?
  status               CropStatus              @default(PLANNED)
  stage                CropCycleStage          @default(PLANTATION)
  unit                 String?
  pricePerUnit         Decimal?                @db.Decimal(10, 2)
  harvestType          CropHarvestType         @default(CONTINUOUS)
  notes                String?
  assignedSchedule     String?                 @db.Text
  advisorReviewStatus  CropAdvisorReviewStatus @default(NONE)
  submittedToAdvisorAt DateTime?
  advisorAcceptedAt    DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?

  expenses              Expense[]
  sales                 Sale[]
  labourEntries         LabourEntry[]
  labourWorkEntries     LabourWorkEntry[]
  fertilizerUsages      FertilizerUsage[]
  sprays                Spray[]
  spraySchedules        SpraySchedule[]
  cropProblems          CropProblem[]
  harvests              Harvest[]
  irrigationRecords     IrrigationRecord[]
  inventoryTransactions InventoryTransaction[]
  activitySchedules     CropActivitySchedule[]

  @@index([plotId])
  @@map("crop_cycles")
}

// ─── Phase 2: Expenses, Sales, Customers, Payments ──────────────────────

model ExpenseCategory {
  id        String   @id @default(uuid())
  key       String   @unique
  labelEn   String
  labelHi   String
  icon      String?
  isSystem  Boolean  @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid())
  farmId          String
  farm            Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plotId          String?
  plot            Plot?           @relation(fields: [plotId], references: [id], onDelete: SetNull)
  cropCycleId     String?
  cropCycle       CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  machineryId     String?
  machinery       Machinery?      @relation(fields: [machineryId], references: [id], onDelete: SetNull)
  partyId         String?
  party           Party?          @relation(fields: [partyId], references: [id], onDelete: SetNull)
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime
  paymentMode     PaymentMode?
  vendorName      String?
  description     String?
  quantity        Float?
  unit            String?
  receiptPhotoUrl String?
  recordedById    String
  recordedBy      User            @relation(fields: [recordedById], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  fertilizerUsages      FertilizerUsage[]
  sprays                Spray[]
  irrigationRecords     IrrigationRecord[]
  inventoryTransactions InventoryTransaction[]
  ledgerEntries         PartyLedgerEntry[]

  @@index([farmId])
  @@index([plotId])
  @@index([cropCycleId])
  @@index([categoryId])
  @@index([machineryId])
  @@index([partyId])
  @@map("expenses")
}

model Party {
  id        String    @id @default(uuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  mobile    String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  ledgerEntries PartyLedgerEntry[]
  expenses      Expense[]

  @@index([ownerId])
  @@map("parties")
}

enum PartyLedgerEntryType {
  SALE_CREDIT
  SALE_PAYMENT
  EXPENSE_CREDIT
  EXPENSE_PAYMENT
}

model PartyLedgerEntry {
  id               String               @id @default(uuid())
  partyId          String
  party            Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type             PartyLedgerEntryType
  amount           Decimal              @db.Decimal(12, 2)
  reason           String
  expenseId        String?
  expense          Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  saleBillId       String?
  saleBill         SaleBill?            @relation(fields: [saleBillId], references: [id], onDelete: SetNull)
  paymentReceiptId String?
  paymentReceipt   PaymentReceipt?      @relation(fields: [paymentReceiptId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([partyId])
  @@map("party_ledger_entries")
}

model PaymentReceipt {
  id              String   @id @default(uuid())
  farmerId        String
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  receiptNo       String
  partyId         String
  partyName       String
  isReceived      Boolean
  previousBalance Decimal  @db.Decimal(12, 2)
  paymentAmount   Decimal  @db.Decimal(12, 2)
  netBalance      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  ledgerEntries PartyLedgerEntry[]

  @@index([farmerId])
  @@map("payment_receipts")
}

model SaleBill {
  id              String   @id @default(uuid())
  farmerId        String
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  billNo          String
  farmerName      String
  partyId         String?
  partyName       String
  partyMobile     String?
  partyAddress    String?
  isCash          Boolean
  items           Json
  totalItems      Int
  totalAmount     Decimal  @db.Decimal(12, 2)
  amountReceived  Decimal  @db.Decimal(12, 2)
  thisSaleBalance Decimal  @db.Decimal(12, 2)
  previousBalance Decimal  @db.Decimal(12, 2)
  netReceivable   Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  ledgerEntries PartyLedgerEntry[]

  @@index([farmerId])
  @@map("sale_bills")
}

model Customer {
  id        String    @id @default(uuid())
  farmerId  String
  farmer    User      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name      String
  mobile    String?
  village   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales    Sale[]
  payments Payment[]

  @@index([farmerId])
  @@map("customers")
}

model Sale {
  id           String       @id @default(uuid())
  farmId       String
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plotId       String?
  plot         Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  cropCycleId  String?
  cropCycle    CropCycle?   @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  saleDate     DateTime
  totalAmount  Decimal      @default(0) @db.Decimal(12, 2)
  paymentMode  PaymentMode?
  notes        String?
  recordedById String
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  items    SaleItem[]
  payments Payment[]

  @@index([farmId])
  @@index([plotId])
  @@index([cropCycleId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Float
  unit         String
  pricePerUnit Decimal  @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id           String       @id @default(uuid())
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId       String?
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount       Decimal      @db.Decimal(12, 2)
  paymentDate  DateTime
  paymentMode  PaymentMode?
  notes        String?
  recordedById String
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([customerId])
  @@index([saleId])
  @@map("payments")
}

// ─── Phase 3: Labour, Fertilizer, Spray, Harvest, Inventory, Machinery, Irrigation ──

model LabourWorker {
