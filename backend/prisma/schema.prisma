  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  schedule SpraySchedule?

  @@index([cropCycleId])
  @@index([expenseId])
  @@map("sprays")
}

model SpraySchedule {
  id                 String              @id @default(uuid())
