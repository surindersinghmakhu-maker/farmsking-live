  rate         Decimal       @db.Decimal(12, 2)
  totalAmount  Decimal       @db.Decimal(12, 2)
  notes        String?
  recordedById String
  recordedBy   User          @relation("WorkEntriesRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([farmerId])
  @@index([workerId])
  @@index([workDate])
  @@map("labour_work_entries")
}

model LabourPayment {
  id           String        @id @default(uuid())
  farmerId     String
  farmer       User          @relation("FarmerLabourPayments", fields: [farmerId], references: [id], onDelete: Cascade)
  workerId     String
