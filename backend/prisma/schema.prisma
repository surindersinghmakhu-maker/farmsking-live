  sprayType SprayType?
  createdAt DateTime   @default(now())
  deletedAt DateTime?

  @@map("spray_product_catalog")
}

/** An advisor's reusable item/dose/alternatives row, picked to quick-fill new spray schedule entries. Advisor-owned; Super Admin can view all. */
model SprayItemTemplate {
  id            String    @id @default(uuid())
  advisorId     String
  advisor       User      @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  sprayType     SprayType?
