  farmerRating       Int?
  farmerFeedback     String?
  followUpDate       DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  photos CropProblemPhoto[]

  @@index([cropCycleId])
  @@index([assignedAdvisorId])
