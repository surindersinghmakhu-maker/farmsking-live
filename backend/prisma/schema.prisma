  deliveryDate    DateTime?
  packedById      String?
  packedBy        User?       @relation("OrdersPackedBy", fields: [packedById], references: [id], onDelete: SetNull)
  packedAt        DateTime?
  dispatchedById  String?
  dispatchedBy    User?       @relation("OrdersDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchedAt    DateTime?
  courierName     String?
  trackingId      String?
  cancelledAt     DateTime?
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount  Decimal?    @db.Decimal(12, 2)

  paymentMode            OrderPaymentMode   @default(COD)
  paymentStatus          OrderPaymentStatus @default(UNPAID)
  phonepeMerchantOrderId String?            @unique
  phonepePaymentState    String?

  items       CustomerOrderItem[]
  redemptions CouponRedemption[]

  @@index([customerId])
  @@index([couponId])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Decimal       @db.Decimal(12, 2)

  @@index([orderId])
  @@map("customer_order_items")
}

model PartnerReferral {
  id           String   @id @default(uuid())
  partnerId    String
  partner      User     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referredName String
  joinDate     DateTime @default(now())
  commission   Decimal  @default(750) @db.Decimal(12, 2)
  status       String   @default("Active")

  @@index([partnerId])
  @@map("partner_referrals")
}

// ─── Business Partner coupons, wallet & withdrawals ─────────────────────

model Coupon {
  id                String            @id @default(uuid())
  code              String            @unique
  businessPartnerId String
  businessPartner   User              @relation("BusinessPartnerCoupons", fields: [businessPartnerId], references: [id], onDelete: Cascade)
  commissionType    DiscountValueType
  commissionValue   Decimal           @db.Decimal(10, 2)
  commissionMaxCap  Decimal?          @db.Decimal(10, 2)
  discountType      DiscountValueType
  discountValue     Decimal           @db.Decimal(10, 2)
  discountMaxCap    Decimal?          @db.Decimal(10, 2)
  minOrderAmount    Decimal?          @db.Decimal(10, 2)
  kind              CouponKind        @default(GENERIC)
  expiresAt         DateTime
  usageLimit        Int
  usedCount         Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  createdById       String
  createdBy         User              @relation("CouponsCreatedByAdmin", fields: [createdById], references: [id])

  redemptions   CouponRedemption[]
  CustomerOrder CustomerOrder[]

  @@index([businessPartnerId])
  @@map("coupons")
}

model CouponRedemption {
  id               String         @id @default(uuid())
  couponId         String
  coupon           Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         User?          @relation("CouponRedemptionsCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  orderId          String?
  order            CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderAmount      Decimal        @db.Decimal(10, 2)
  discountAmount   Decimal        @db.Decimal(10, 2)
  commissionAmount Decimal        @db.Decimal(10, 2)
  creditedAt       DateTime?
  redeemedAt       DateTime       @default(now())

  @@index([couponId])
  @@index([orderId])
  @@map("coupon_redemptions")
}

model WalletTransaction {
  id                  String                @id @default(uuid())
  userId              String
  user                User                  @relation("WalletTransactions", fields: [userId], references: [id], onDelete: Cascade)
  type                WalletTransactionType
  amount              Decimal               @db.Decimal(10, 2)
  reason              String
  couponRedemptionId  String?
  withdrawalRequestId String?
  /**
   * The farmer whose coupon redemption (or other action) triggered this transaction, when applicable — lets the wallet owner see "which farmer's ID this happened on" in Full Details.
   */
  relatedUserId       String?
  relatedUser         User?                 @relation("WalletTransactionsRelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())

  @@index([userId])
  @@index([relatedUserId])
  @@map("wallet_transactions")
}

/// Platform-wide activity/audit trail — one row per mutating API request (POST/PATCH/PUT/DELETE).
/// Written by a global interceptor, never blocks the actual request if logging itself fails.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditLogsActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  method     String
  path       String
  action     String
  targetId   String?
  statusCode Int
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A saved delivery address for the shopping/orders flow — one account can have several (Home/Farm/Work),
/// picked at checkout. Unrelated to the farmer-side `Customer` model above (that's a farmer's own buyer).
model CustomerAddress {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tag        String
  line       String
  mobile     String?
  postOffice String
  district   String
  state      String
  pincode    String
  createdAt  DateTime @default(now())

  @@index([ownerId])
  @@map("customer_addresses")
}

/// Singleton row of app-wide, Super-Admin-editable settings — currently just the UPI ID that receives
/// order/plan payments. Always exactly one row, id fixed to "default".
model AppSetting {
  id                    String   @id @default("default")
  appName               String   @default("FarmsKing")
  logoUrl               String?
  tagline               String?
  upiId                 String?
  upiPayeeName          String?
  groupVoiceCallEnabled Boolean  @default(true)
  whatsappGroupSyncEnabled Boolean @default(true)
  whatsappAutoAddEnabled   Boolean @default(true)
  whatsappAutoRemoveEnabled Boolean @default(true)
  whatsappGroupJid      String?
  featureFlags          Json?
  updatedAt             DateTime @updatedAt
  updatedById           String?
  updatedBy             User?    @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}


/// Single unified home for every coupon-kind's default rates/validity — Referral, Commission-Based, and
/// Special (personal invite). Farmer/Advisor Plan pricing lives separately in FarmerPlanPricing (one row
/// per plan tier, a different shape), but both are reachable from the same Coupon Setting screen.
model CouponSystemSetting {
  id                                 String   @id @default("default")
  partnerCouponDiscountPercent       Decimal  @default(10) @db.Decimal(5, 2)
  partnerCouponCommissionPercent     Decimal  @default(5) @db.Decimal(5, 2)
  partnerCouponMinOrderAmount        Decimal  @default(500) @db.Decimal(10, 2)
  partnerCouponMaxDiscountCap        Decimal  @default(100) @db.Decimal(10, 2)
  partnerCouponValidityDays          Int      @default(365)
  referralCommissionPercent          Decimal  @default(5) @db.Decimal(5, 2)
  referralDiscountPercent            Decimal  @default(10) @db.Decimal(5, 2)
  referralMaxDiscountCap             Decimal  @default(100) @db.Decimal(10, 2)
  referralOrderLimit                 Int      @default(5)
  referralCouponValidityDays         Int      @default(365)
  /// Defaults for admin-issued "Commission Based" (GENERIC kind) partner coupons — prefill only, each coupon can still override every field.
  commissionCouponDiscountPercent    Decimal  @default(10) @db.Decimal(5, 2)
  commissionCouponCommissionPercent  Decimal  @default(5) @db.Decimal(5, 2)
  commissionCouponMinOrderAmount     Decimal  @default(0) @db.Decimal(10, 2)
  commissionCouponMaxDiscountCap     Decimal  @default(100) @db.Decimal(10, 2)
  commissionCouponValidityDays       Int      @default(30)
  /// Defaults for the auto-issued "Special" (PERSONAL_INVITE kind) coupon every user gets.
  inviteCouponDiscountPercent        Decimal  @default(5) @db.Decimal(5, 2)
  inviteCouponCommissionPercent      Decimal  @default(5) @db.Decimal(5, 2)
  inviteCouponValidityDays           Int      @default(3650)
  inviteCouponUsageLimit             Int      @default(100000)
  updatedAt                          DateTime @updatedAt
  updatedById                        String?
  updatedBy                          User?    @relation("CouponSystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("coupon_system_settings")
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  businessPartnerId String
  businessPartner   User             @relation("WithdrawalRequestsPartner", fields: [businessPartnerId], references: [id], onDelete: Cascade)
  requestedAmount   Decimal          @db.Decimal(10, 2)
  approvedAmount    Decimal?         @db.Decimal(10, 2)
  status            WithdrawalStatus @default(PENDING)
  requestedAt       DateTime         @default(now())
  processedAt       DateTime?
  processedById     String?
  processedBy       User?            @relation("WithdrawalRequestsProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  notes             String?

  @@index([businessPartnerId])
  @@map("withdrawal_requests")
}

model WeatherTipTemplate {
  id          String            @id @default(uuid())
  title       String
  message     String
  triggerType WeatherTipTrigger
  thresholdC  Int?
  isActive    Boolean           @default(true)
  createdById String
  createdBy   User              @relation("WeatherTipTemplatesCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("weather_tip_templates")
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@map("messages")
}

model PlanRenewalCoupon {
  id                String    @id @default(uuid())
  code              String    @unique
  daysGranted       Int
  createdById       String
  createdBy         User      @relation("PlanRenewalCouponsCreatedBy", fields: [createdById], references: [id])
  assignedFarmerId  String?
  assignedFarmer    User?     @relation("PlanRenewalCouponsAssignedFarmer", fields: [assignedFarmerId], references: [id], onDelete: SetNull)
  assignedAdvisorId String?
  assignedAdvisor   User?     @relation("PlanRenewalCouponsAssignedAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  isUsed            Boolean   @default(false)
  usedAt            DateTime?
  bonusDayApplied   Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@map("plan_renewal_coupons")
}

/// A farmer's BASIC-plan-days coupon. Admin/Super Admin generates it at a flat ₹2/day list price;
/// a Business Partner may then buy it at a 10% discount (debited from their wallet) before handing
/// the code to a farmer, who redeems it for BASIC-plan days. Redemption does not require a purchase —
/// an admin-gifted code can be redeemed directly too.
model BasicPlanCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  daysGranted    Int
  listPrice      Decimal   @db.Decimal(10, 2)
  createdById    String
  createdBy      User      @relation("BasicPlanCouponsCreatedBy", fields: [createdById], references: [id])
  purchasedById  String?
  purchasedBy    User?     @relation("BasicPlanCouponsPurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)
  purchasePrice  Decimal?  @db.Decimal(10, 2)
  purchasedAt    DateTime?
  isUsed         Boolean   @default(false)
  usedByFarmerId String?
  usedByFarmer   User?     @relation("BasicPlanCouponsUsedByFarmer", fields: [usedByFarmerId], references: [id], onDelete: SetNull)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("basic_plan_coupons")
}

// ─── Farmer 3-Tier Plan System ───────────────────────────────────────────

/// Farmer ki current active plan record. Har farmer ka ek hi row hoga (unique on farmerId).
model FarmerPlan {
  id        String                 @id @default(uuid())
  farmerId  String                 @unique
  farmer    User                   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  plan      FarmerSubscriptionPlan @default(FREE)
  startDate DateTime               @default(now())
  endDate   DateTime? // null = FREE plan (no expiry)
  expiredAt DateTime? // when this plan actually lapsed — drives the 2-day grace / 3-month renew-history window
  couponId  String? // which coupon activated this plan
  coupon    FarmerPlanCoupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("farmer_plans")
}

/// Advisor ki current active plan record (LITE or PLUS).
model AdvisorTierPlan {
  id        String                  @id @default(uuid())
  advisorId String                  @unique
  advisor   User                    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  plan      AdvisorSubscriptionPlan @default(LITE)
  startDate DateTime                @default(now())
  endDate   DateTime? // null = LITE plan (no expiry)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@map("advisor_tier_plans")
}

/// Super admin creates these coupons to give farmers BASIC or PREMIUM plans.
model FarmerPlanCoupon {
  id                        String                 @id @default(uuid())
  code                      String                 @unique
  category                  PlanCouponCategory     @default(FARMER_PLAN)
  plan                      FarmerSubscriptionPlan // BASIC or PREMIUM
  daysGranted               Int // how many days to activate
  assignedFarmerId          String? // optional: lock to a specific farmer
  assignedFarmer            User?                  @relation("FarmerPlanCouponsAssignedFarmer", fields: [assignedFarmerId], references: [id], onDelete: SetNull)
  assignedAdvisorId         String? // optional: issue to an advisor instead, who can apply it to any of their farmers
  assignedAdvisor           User?                  @relation("FarmerPlanCouponsAssignedAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  assignedBusinessPartnerId String? // optional: issue to a business partner instead, who earns a commission when it's redeemed
  assignedBusinessPartner   User?                  @relation("FarmerPlanCouponsAssignedBusinessPartner", fields: [assignedBusinessPartnerId], references: [id], onDelete: SetNull)
  isUsed                    Boolean                @default(false)
  usedAt                    DateTime?
  usedByFarmerId            String? // which farmer actually redeemed
  usedByFarmer              User?                  @relation("FarmerPlanCouponsUsedBy", fields: [usedByFarmerId], references: [id], onDelete: SetNull)
  expiresAt                 DateTime? // coupon validity (optional)
  generationCostAmount      Decimal?               @db.Decimal(10, 2) // snapshot of what was debited from the assignee's wallet at creation time, if any
  createdById               String
  createdBy                 User                   @relation("FarmerPlanCouponsCreatedBy", fields: [createdById], references: [id])
  createdByRole             Role?
  payoutAmount              Decimal?               @db.Decimal(10, 2)
  payoutRecipientId         String?
  createdAt                 DateTime               @default(now())

  farmerPlans FarmerPlan[]

  @@index([assignedFarmerId])
  @@index([assignedBusinessPartnerId])
  @@index([createdById])
  @@map("farmer_plan_coupons")
}

/// Super-admin-editable price + commission-split config, one row per paid Farmer plan tier.
/// Redeeming a coupon prorates these shares by daysGranted / billingPeriodDays and credits the
/// business partner's/advisor's wallet accordingly — the remainder is the platform's (admin) share.
model FarmerPlanPricing {
  id                           String                 @id @default(uuid())
  plan                         FarmerSubscriptionPlan
  price                        Decimal                @db.Decimal(10, 2)
  billingPeriodDays            Int // e.g. 365 for a yearly plan, 30 for a monthly one
  partnerShareType             DiscountValueType // PERCENTAGE (e.g. BASIC's 10%) or FIXED (e.g. STANDARD/PREMIUM's flat ₹ cut)
  partnerShareValue            Decimal                @db.Decimal(10, 2)
  advisorShareValue            Decimal?               @db.Decimal(10, 2) // null when the plan has no advisor (e.g. BASIC)
  adminShareValue              Decimal?               @db.Decimal(10, 2) // informational — platform's own cut, for display only
  partnerGenerationCostPercent Decimal?               @db.Decimal(5, 2) // % of price debited from a Business Partner's wallet the moment they're issued a coupon for this plan
  advisorGenerationCostPercent Decimal?               @db.Decimal(5, 2) // % of price debited from an Advisor's wallet the moment they're issued a coupon for this plan
  maxTotalCrops                Int?                   // null = unlimited
  maxActiveCrops               Int?                   // null = unlimited
  advisorIncluded              Boolean                @default(true)
  chatEnabled                  Boolean                @default(true)
  weatherEnabled               Boolean                @default(true)
  gardenAdvisorIncluded        Boolean                @default(false)
  isActive                     Boolean                @default(true)
  updatedAt                    DateTime               @updatedAt
  updatedById                  String?
  updatedBy                    User?                  @relation("FarmerPlanPricingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([plan, billingPeriodDays])
  @@map("farmer_plan_pricing")
}

// ─── Gardener 2-Tier Plan System ─────────────────────────────────────────

/// Gardener ki current active plan record. Har gardener ka ek hi row hoga (unique on gardenerId).
model GardenerPlan {
  id         String                   @id @default(uuid())
  gardenerId String                   @unique
  gardener   User                     @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
  plan       GardenerSubscriptionPlan @default(FREE)
  startDate  DateTime                 @default(now())
  endDate    DateTime? // null = FREE plan (no expiry)
  expiredAt  DateTime? // when this plan actually lapsed — drives the 2-day grace / 3-month renew-history window
  couponId   String?
  coupon     GardenerPlanCoupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@map("gardener_plans")
}

/// Admin creates these coupons to give gardeners PREMIUM (paid-only, no BASIC tier for gardeners).
model GardenerPlanCoupon {
  id                 String                   @id @default(uuid())
  code               String                   @unique
  plan               GardenerSubscriptionPlan // always PREMIUM
  daysGranted        Int
  assignedGardenerId String?
  assignedGardener   User?                    @relation("GardenerPlanCouponsAssignedGardener", fields: [assignedGardenerId], references: [id], onDelete: SetNull)
  isUsed             Boolean                  @default(false)
  usedAt             DateTime?
  usedByGardenerId   String?
  usedByGardener     User?                    @relation("GardenerPlanCouponsUsedBy", fields: [usedByGardenerId], references: [id], onDelete: SetNull)
  expiresAt          DateTime?
  createdById        String
  createdBy          User                     @relation("GardenerPlanCouponsCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime                 @default(now())

  gardenerPlans GardenerPlan[]

  @@index([assignedGardenerId])
  @@index([createdById])
  @@map("gardener_plan_coupons")
}

model AdminChatMessage {
  id             String   @id @default(uuid())
  farmerId       String
  farmer         User     @relation("AdminChatFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  adminId        String?
  admin          User?    @relation("AdminChatAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  senderRole     Role     @default(FARMER)
  message        String   @db.Text
  imageUrl       String?
  isReadByFarmer Boolean  @default(false)
  isReadByAdmin  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([farmerId])
  @@index([adminId])
  @@map("admin_chat_messages")
}

// ─── Unified Party System & Arhtiya Management ──────────────────────────────

model UnifiedParty {
  id            String      @id @default(uuid())
  kingId        String      @unique // Uniform format: FK-100238
  type          PartyType   @default(INDIVIDUAL)
  name          String
  mandiName     String?
  shopNumber    String?
  mobile        String?
  address       String?
  village       String?
  district      String?
  state         String?
  roles         PartyRole[]

  ownerFarmerId String?
  ownerFarmer   User?       @relation("FarmerPrivateParties", fields: [ownerFarmerId], references: [id], onDelete: Cascade)

  userId        String?     @unique
  user          User?       @relation("UserUnifiedParty", fields: [userId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  arhtiyaTransactions ArhtiyaTransaction[]

  @@index([kingId])
  @@index([ownerFarmerId])
  @@map("unified_parties")
}

model ArhtiyaTransaction {
  id                  String                 @id @default(uuid())
  farmerId            String
  farmer              User                   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  partyId             String
  party               UnifiedParty           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type                ArhtiyaTransactionType
  amount              Decimal                @db.Decimal(12, 2)
  transactionDate     DateTime

  /// Feature 1: Advance Cash & Auto Interest Engine
  interestRateMonthly Decimal?               @db.Decimal(5, 2) // e.g. 1.50 (% per month)
  interestAccruedDays Int?
  interestAmount      Decimal?               @db.Decimal(10, 2)

  /// Feature 2: Crop Sale Details & Mandi Unit Converter
  cropCycleId         String?
  cropName            String?
  inputUnit           MandiUnit?             @default(QUINTAL)
  inputQuantity       Float?
  quantityQuintals    Float?
  ratePerQuintal      Decimal?               @db.Decimal(10, 2)
  grossAmount         Decimal?               @db.Decimal(12, 2)
  commissionPercent   Decimal?               @db.Decimal(5, 2)
  commissionAmount    Decimal?               @db.Decimal(10, 2)
  otherCharges        Decimal?               @db.Decimal(10, 2)
  netAmount           Decimal?               @db.Decimal(12, 2)

  /// Feature 3: Digital J-Form Record
  jFormNumber         String?
  jFormDate           DateTime?
  jFormPhotoUrl       String?

  notes               String?
  createdAt           DateTime               @default(now())

  @@index([farmerId])
  @@index([partyId])
  @@map("arhtiya_transactions")
}

// ─── Customer Referral & 2-Tier Lifetime Royalty Engine ──────────────────────

model UserReferral {
