// ─── Phase 6: Gardener, Customer, Business Partner Dashboards ────────────

model Garden {
  id          String   @id @default(uuid())
  gardenerId  String
  gardener    User     @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
  name        String
  location    String?
  area        Float?
  healthScore Int      @default(85)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits   GardenVisit[]
  plants   Plant[]
  expenses GardenExpense[]

  @@index([gardenerId])
  @@map("gardens")
}

model Plant {
  id          String    @id @default(uuid())
  gardenId    String
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  name        String
  species     String?
  plantedDate DateTime?
  healthNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  expenses GardenExpense[]

  @@index([gardenId])
  @@map("plants")
}

model GardenVisit {
  id            String   @id @default(uuid())
  gardenId      String
  garden        Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  visitTitle    String
  scheduledTime DateTime
  status        String   @default("Scheduled")
  notes         String?
  createdAt     DateTime @default(now())

  @@index([gardenId])
  @@map("garden_visits")
}

enum SellerType {
  FARMER
  COMMERCIAL
}

enum RtoBearer {
  ADMIN
  VENDOR
  SHARED
}

enum CatalogApprovalMode {
  MANUAL
  AUTO
}

enum ProductModerationStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  OUT_OF_STOCK
}

enum SubOrderStatus {
  PLACED
  ACCEPTED
  PACKED
  SHIPPED
  DELIVERED
  RTO_DELIVERED
  CANCELLED
}

enum SettlementStatus {
  HOLD
  SETTLED
  DEDUCTED
}

model Product {
  id           String   @id @default(uuid())
  name         String
  title        String?
  brand        String?
  description  String?
  category     String?
  categorySlug String?
  unit         String   @default("piece")
  price        Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  rating       Float    @default(4.5)
  isTopSeller  Boolean  @default(false)
  imageUrl     String?
  stockQty     Int      @default(0)
  isActive     Boolean  @default(true)
  createdById  String
  createdBy    User     @relation("ProductsCreatedBy", fields: [createdById], references: [id])

  // Multi-vendor marketplace fields
  sellerStoreId String?
  sellerStore   SellerStore? @relation(fields: [sellerStoreId], references: [id], onDelete: SetNull)
  sku           String?
  hsnCode       String?
  gstPercentage Decimal      @default(18.00) @db.Decimal(5, 2)
  weightKg      Float        @default(0.5)
  deadWeightKg  Float?       @default(0.5)
  lengthCm      Float        @default(10)
  widthCm       Float        @default(10)
  heightCm      Float        @default(10)

  // Agri Technical & Mandatory fields
  technicalName      String?
  dosageInstructions String?
  suitableCrops      String?
  targetPests        String?
  expiryDate         DateTime?
  batchNumber        String?

  // COD, Return, Replacement & Commission
  isCodAllowed                 Boolean  @default(true)
  isReturnable                 Boolean  @default(true)
  returnWindowDays             Int      @default(7)
  isReplaceable                Boolean  @default(true)
  replacementWindowDays        Int      @default(7)
  returnPolicyNotes            String?
  commissionOverridePercentage Decimal? @db.Decimal(5, 2)

  // Photo Uploads
  imageFrontUrl     String?
  imageBackLabelUrl String?
  imageDosageUrl    String?
  imageProductUrl   String?
  galleryImages     String[] @default([])

  // Moderation
  moderationStatus ProductModerationStatus @default(PENDING_REVIEW)
  rejectionReason  String?

  // Bulk Quantity Tier Discounts
  bulkDiscountMinQty     Int?
  bulkDiscountPercentage Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems CustomerOrderItem[]
  reviews    ProductReview[]
  wishlists  Wishlist[]

  @@index([category])
  @@index([categorySlug])
  @@index([isActive])
  @@index([sellerStoreId])
  @@index([moderationStatus])
  @@map("products")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  title     String?
  comment   String?  @db.Text
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model CustomerOrder {
  id              String      @id @default(uuid())
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNumber     String      @unique
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(PLACED)
  deliveryAddress String?
  orderDate       DateTime    @default(now())
  deliveryDate    DateTime?
  packedById      String?
  packedBy        User?       @relation("OrdersPackedBy", fields: [packedById], references: [id], onDelete: SetNull)
  packedAt        DateTime?
  dispatchedById  String?
  dispatchedBy    User?       @relation("OrdersDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  dispatchedAt    DateTime?
  courierName     String?
  trackingId      String?
  cancelledAt     DateTime?
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount  Decimal?    @db.Decimal(12, 2)

  walletUsedAmount  Decimal? @db.Decimal(12, 2)
  walletPlatformFee Decimal? @db.Decimal(12, 2)
  walletGstAmount   Decimal? @db.Decimal(12, 2)
  platformExpense   Boolean  @default(false)

  paymentMode            OrderPaymentMode   @default(COD)
  paymentStatus          OrderPaymentStatus @default(UNPAID)
  phonepeMerchantOrderId String?            @unique
  phonepePaymentState    String?

  items          CustomerOrderItem[]
  subOrders      SubOrder[]
  redemptions    CouponRedemption[]
  shippingLogs   ShippingLog[]
  returnRequests ReturnRequest[]
  invoices       OrderInvoice[]

  @@index([customerId])
  @@index([couponId])
  @@index([status])
  @@index([orderDate])
  @@index([customerId, status, orderDate])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Decimal       @db.Decimal(12, 2)

  // Multi-vendor payout & TCS tracking fields
  sellerStoreId      String?
  sellerStore        SellerStore?  @relation(fields: [sellerStoreId], references: [id], onDelete: SetNull)
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  commissionAmount   Decimal       @default(0) @db.Decimal(12, 2)
  tcsAmount          Decimal       @default(0) @db.Decimal(12, 2)
  sellerPayoutAmount Decimal       @default(0) @db.Decimal(12, 2)
  sellerPayoutId     String?
  sellerPayout       SellerPayout? @relation(fields: [sellerPayoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerStoreId])
  @@index([sellerPayoutId])
  @@map("customer_order_items")
}
