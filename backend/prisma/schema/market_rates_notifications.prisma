// ─── Phase 5: Market rates, Notifications ───────────────────────────────

model MarketRate {
  id         String   @id @default(uuid())
  cropName   String
  variety    String?
  market     String
  state      String?
  district   String?
  minPrice   Decimal? @db.Decimal(12, 2)
  maxPrice   Decimal? @db.Decimal(12, 2)
  modalPrice Decimal? @db.Decimal(12, 2)
  unit       String   @default("quintal")
  rateDate   DateTime
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@index([cropName, rateDate])
  @@map("market_rates")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
