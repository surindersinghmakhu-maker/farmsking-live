// ─── Multi-Vendor Marketplace Core Models ────────────────────────────────

model SellerStore {
  id                         String              @id @default(uuid())
  sellerId                   String              @unique
  seller                     User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeName                  String
  slug                       String              @unique
  sellerType                 SellerType          @default(FARMER)
  legalName                  String?
  gstin                      String?             @unique
  isCompositionDealer        Boolean             @default(false)
  gstEnrolmentId             String?
  panNumber                  String?
  aadhaarLast4               String?
  upiId                      String?
  kycStatus                  SellerKycStatus     @default(PENDING)
  kycVerifiedAt              DateTime?
  kycVerifiedById            String?
  rejectionReason            String?
  bankAccountNo              String?
  bankIfsc                   String?
  bankBeneficiaryName        String?
  cashfreeVendorId           String?             @unique
  shiprocketPickupLocationId String?
  shiprocketPickupNickname   String?
  pickupAddress              String?
  pickupCity                 String?
  pickupState                String?
  pickupPincode              String?
  wantsToSellFood            Boolean             @default(false)
  fssaiNo                    String?
  fssaiCertificateUrl        String?
  fssaiExpiryDate            DateTime?
  isFssaiApproved            Boolean             @default(false)
  agriLicenseNo              String?
  agriLicenseExpiryDate      DateTime?
  seedLicenseNo              String?
  seedLicenseExpiry          DateTime?
  seedLicenseDocUrl          String?
  pesticideLicenseNo         String?
  pesticideLicenseExpiry     DateTime?
  pesticideLicenseDocUrl     String?
  fertilizerLicenseNo        String?
  fertilizerLicenseExpiry    DateTime?
  fertilizerLicenseDocUrl    String?
  sellerAgreementAcceptedAt  DateTime?
  sellerAgreementVersion     String?
  additionalDoc1Title        String?
  additionalDoc1Url          String?
  additionalDoc2Title        String?
  additionalDoc2Url          String?
  gstDocUrl                  String?
  panDocUrl                  String?
  chequeDocUrl               String?
  aadhaarFrontUrl            String?
  aadhaarBackUrl             String?
  tradeLicenseUrl            String?
  commissionRate             Decimal             @default(8.00) @db.Decimal(5, 2)
  categoryCommissions        Json?               @default("{}")
  rtoBearer                  RtoBearer           @default(VENDOR)
  rtoSharedVendorRatio       Decimal             @default(50.00) @db.Decimal(5, 2)
  catalogApprovalMode        CatalogApprovalMode @default(MANUAL)
  rating                     Float               @default(4.8)
  isActive                   Boolean             @default(true)
  isOfficialStore            Boolean             @default(false)
  officialBadgeText          String?             @default("FarmsKing Official Store")
  invoicePrefix              String?
  invoiceLastSequence        Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  products     Product[]
  payouts      SellerPayout[]
  orderItems   CustomerOrderItem[]
  subOrders    SubOrder[]
  shippingLogs ShippingLog[]
  gstr8Reports Gstr8Report[]
  invoices     OrderInvoice[]

  @@index([sellerId])
  @@index([kycStatus])
  @@index([isActive])
  @@map("seller_stores")
}

model SubOrder {
  id                   String           @id @default(uuid())
  orderId              String
  order                CustomerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerStoreId        String
  sellerStore          SellerStore      @relation(fields: [sellerStoreId], references: [id])
  subtotal             Decimal          @db.Decimal(12, 2)
  commissionAmount     Decimal          @db.Decimal(12, 2)
  shippingFee          Decimal          @default(0.00) @db.Decimal(12, 2)
  rtoFee               Decimal          @default(0.00) @db.Decimal(12, 2)
  vendorNetPayout      Decimal          @db.Decimal(12, 2)
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  shiprocketAwbCode    String?
  shippingLabelUrl     String?
  orderStatus          SubOrderStatus   @default(PLACED)
  settlementStatus     SettlementStatus @default(HOLD)
  cashfreeTransferId   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([sellerStoreId])
  @@index([orderStatus])
  @@index([settlementStatus])
  @@map("sub_orders")
}

model ReturnRequest {
  id           String        @id @default(uuid())
  orderId      String
  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId   String?
  subOrder     SubOrder?     @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason       String
  photoUrl     String?
  status       ReturnStatus  @default(PENDING)
  refundAmount Decimal       @db.Decimal(12, 2)
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

model SellerPayout {
  id                    String             @id @default(uuid())
  sellerStoreId         String
  sellerStore           SellerStore        @relation(fields: [sellerStoreId], references: [id], onDelete: Cascade)
  payoutRefNo           String             @unique
  totalGrossAmount      Decimal            @db.Decimal(12, 2)
  totalCommissionAmount Decimal            @db.Decimal(12, 2)
  commissionGstAmount   Decimal            @default(0.00) @db.Decimal(12, 2)
  totalTcsAmount        Decimal            @db.Decimal(12, 2)
  tds194OAmount         Decimal            @default(0.00) @db.Decimal(12, 2)
  netPayoutAmount       Decimal            @db.Decimal(12, 2)
  status                SellerPayoutStatus @default(PENDING)
  cashfreeTransferId    String?
  cashfreeUtrNo         String?
  paidAt                DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  orderItems CustomerOrderItem[]

  @@index([sellerStoreId])
  @@index([status])
  @@index([createdAt])
  @@map("seller_payouts")
}

model ShippingLog {
  id                   String         @id @default(uuid())
  orderId              String
  order                CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerStoreId        String?
  sellerStore          SellerStore?   @relation(fields: [sellerStoreId], references: [id], onDelete: SetNull)
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  awbCode              String?
  courierName          String?
  status               ShipmentStatus @default(UNASSIGNED)
  labelUrl             String?
  manifestUrl          String?
  pickupScheduledAt    DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([orderId])
  @@index([sellerStoreId])
  @@index([status])
  @@map("shipping_logs")
}

model Gstr8Report {
  id               String      @id @default(uuid())
  sellerStoreId    String
  sellerStore      SellerStore @relation(fields: [sellerStoreId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  totalGrossSales  Decimal     @db.Decimal(12, 2)
  totalSalesReturn Decimal     @db.Decimal(12, 2)
  netTaxableValue  Decimal     @db.Decimal(12, 2)
  cgstTcs          Decimal     @db.Decimal(12, 2)
  sgstTcs          Decimal     @db.Decimal(12, 2)
  igstTcs          Decimal     @db.Decimal(12, 2)
  totalTcs         Decimal     @db.Decimal(12, 2)
  status           String      @default("GENERATED")
  createdAt        DateTime    @default(now())

  @@unique([sellerStoreId, month, year])
  @@index([sellerStoreId])
  @@index([month, year])
  @@map("gstr8_reports")
}

enum InvoiceType {
  CUSTOMER_INVOICE
  COMMISSION_INVOICE
  PAYOUT_STATEMENT
  CREDIT_NOTE
}

model InvoiceSequence {
  id            String   @id // e.g. FY2627_CUSTOMER_INVOICE
  financialYear String // e.g. 2627
  type          String // CUSTOMER_INVOICE | COMMISSION_INVOICE | PAYOUT_STATEMENT | CREDIT_NOTE
  lastSequence  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([financialYear, type])
  @@map("invoice_sequences")
}

model OrderInvoice {
  id                  String         @id @default(uuid())
  orderId             String?
  order               CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subOrderId          String?
  sellerStoreId       String?
  sellerStore         SellerStore?   @relation(fields: [sellerStoreId], references: [id], onDelete: SetNull)
  invoiceNumber       String         @unique
  invoiceType         InvoiceType    @default(CUSTOMER_INVOICE)
  financialYear       String
  customerName        String
  customerGstin       String?
  sellerName          String
  sellerGstin         String?
  grossAmount         Decimal        @db.Decimal(12, 2)
  netTaxableAmount    Decimal        @db.Decimal(12, 2)
  gstAmount           Decimal        @db.Decimal(12, 2)
  cgstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  sgstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  igstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  tcsAmount           Decimal        @default(0) @db.Decimal(12, 2)
  tdsAmount           Decimal        @default(0) @db.Decimal(12, 2)
  sacCode             String?
  placeOfSupply       String?
  commissionAmount    Decimal        @default(0) @db.Decimal(12, 2)
  commissionGstAmount Decimal        @default(0) @db.Decimal(12, 2)
  pdfUrl              String?
  issuedAt            DateTime       @default(now())
  createdAt           DateTime       @default(now())

  @@index([orderId])
  @@index([subOrderId])
  @@index([sellerStoreId])
  @@index([invoiceNumber])
  @@index([invoiceType])
  @@map("order_invoices")
}

model PartnerReferral {
  id           String   @id @default(uuid())
  partnerId    String
  partner      User     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referredName String
  joinDate     DateTime @default(now())
  commission   Decimal  @default(750) @db.Decimal(12, 2)
  status       String   @default("Active")

  @@index([partnerId])
  @@map("partner_referrals")
}

/// Income Tax TDS (Sec 194-O / 194-H / 194-J / 206AA) deduction register for CA, Accountant & 26Q Filing
model TdsLedger {
  id             String    @id @default(uuid())
  deducteeId     String
  deducteeName   String
  deducteeRole   String
  panNumber      String?
  panAvailable   Boolean   @default(false)
  financialYear  String
  quarter        String    // Q1 | Q2 | Q3 | Q4
  section        String    // 194O | 194H | 194J | 206AA
  sourceType     String    // SELLER_PAYOUT | AGENT_COMMISSION | ADVISOR_FEE | TRAINER_FEE | WITHDRAWAL
  sourceId       String
  grossAmount    Decimal   @db.Decimal(12, 2)
  tdsRate        Decimal   @db.Decimal(5, 2)
  tdsAmount      Decimal   @db.Decimal(12, 2)
  netAmount      Decimal   @db.Decimal(12, 2)
  challanStatus  String    @default("PENDING") // PENDING | DEPOSITED | FILED_26Q
  bsrCode        String?
  challanNo      String?
  depositedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceType, sourceId])
  @@index([deducteeId])
  @@index([financialYear, quarter])
  @@index([section])
  @@map("tds_ledgers")
}

/// Statutory Government & Legal Compliance Register for Advocate / CS / CA oversight
model StatutoryComplianceRecord {
  id          String    @id @default(uuid())
  category    String    // MCA_ROC | GST | INCOME_TAX_TDS | AGRI_LICENSE | PAYMENT_GATEWAY | LEGAL_NOTICE | AGREEMENT
  title       String
  authority   String?   // e.g. ROC Chandigarh, CBIC GSTN, Income Tax TRACES, Dept of Agriculture Punjab, RBI PG
  referenceNo String?
  dueDate     DateTime?
  filedDate   DateTime?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLIANT | OVERDUE
  assignedTo  String?   @default("ADVOCATE") // ADVOCATE | CA | ACCOUNTANT | DIRECTOR
  documentUrl String?
  notes       String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([dueDate])
  @@map("statutory_compliance_records")
}

model MediaStore {
  id           String    @id
  uploadedById String?
  cropId       String?
  fileUrl      String
  thumbnailUrl String?
  mediaType    String    @default("IMAGE")
  mimeType     String
  originalName String
  sizeBytes    Int       @default(0)
  provider     String    @default("CLOUDFLARE_R2")
  bucketName   String?
  storagePath  String?
  isArchived   Boolean   @default(false)
  archivedAt   DateTime? @db.Timestamptz(6)
  expiresAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("media_store")
}

model CropRemark {
  cropId       String   @id
  uploadedById String?
  remarksText  String   @default("")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@map("crop_remarks")
}

model CropRemarkHistory {
  id           String   @id
  cropId       String
  uploadedById String?
  remarksText  String   @default("")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @db.Timestamptz(6)

  @@index([cropId])
  @@map("crop_remarks_history")
}

model SupervisorRequest {
  id           String    @id
  farmerId     String
  supervisorId String
  status       String    @default("PENDING")
  featuresConfig Json    @default("{}")
  note         String?
  respondedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("supervisor_requests")
}
