{
  "expo": {
    "name": "FarmsKing",
    "slug": "farmsking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farmsking",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmsking.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FarmsKing requires camera access to scan crop diseases and upload product photos.",
        "NSPhotoLibraryUsageDescription": "FarmsKing requires photo library access to upload crop and profile images.",
        "NSMicrophoneUsageDescription": "FarmsKing requires microphone access for active group voice advisory calls.",
        "NSLocationWhenInUseUsageDescription": "FarmsKing requires location access to provide localized village weather advisory."
      }
    },
    "android": {
      "package": "com.farmsking.app",
      "versionCode": 1,
      "targetSdkVersion": 34,
      "compileSdkVersion": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ad9bd2ac-409b-4f76-b6cb-37bf1bec59dd"
      }
    },
    "owner": "surindersinghmakhu"
  }
}
